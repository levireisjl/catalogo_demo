{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A clothing item in the catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "price": { "type": "number", "description": "Product price" },
        "description": { "type": "string", "description": "Product description" },
        "category": { "type": "string", "description": "Product category (e.g., T-Shirts, Dresses)" },
        "sizes": { "type": "array", "items": { "type": "string" }, "description": "Available sizes" },
        "colors": { "type": "array", "items": { "type": "string" }, "description": "Available colors" },
        "image_urls": { "type": "array", "items": { "type": "string" }, "description": "List of image URLs" },
        "featured": { "type": "boolean", "description": "Whether it shows on home page" },
        "in_stock": { "type": "boolean", "description": "Whether it's available for purchase" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "price", "category", "in_stock", "created_at"]
    },
    "Admin": {
      "title": "Admin",
      "description": "A user with administrative privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of clothing items"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of authorized admin users"
    }
  }
}
